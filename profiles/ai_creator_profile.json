  "hook_opener_taxonomy": [
    {
      "name": "declarative_launch",
      "pattern_example": "X just launched / X just dropped / X just unveiled",
      "frequency_observed": 0.35
    },
    {
      "name": "utility_callout",
      "pattern_example": "This repo / This tool / This X does Y",
      "frequency_observed": 0.18
