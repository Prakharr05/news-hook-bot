    {
      "name": "tutorial_framing",
      "pattern_example": "Let me show you exactly how to...",
      "frequency_observed": 0.18
    },
    {
      "name": "competitive_benchmark",
      "pattern_example": "X just beat Y in benchmarks",
      "frequency_observed": 0.12
